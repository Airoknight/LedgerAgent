# LedgerAgent Environment Configuration

# Application
APP_NAME=LedgerAgent
ENVIRONMENT=development
DEBUG=True

# Backend API
API_V1_STR=/api/v1
SECRET_KEY=ledgeragent-super-secret-dev-key-change-in-production-2026

# Database: SQLite for instant local dev, or PostgreSQL
DATABASE_URL=sqlite:///./ledgeragent.db
# DATABASE_URL=postgresql://postgres:password123@localhost:5432/ledgeragent

# Storage directory for uploaded documents and derivatives
STORAGE_DIR=./storage_local

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

